# Configuración local. Copie a .env y complete los valores privados.
DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_URL="http://localhost:3000"
# Genere un secreto aleatorio antes de iniciar la aplicación.
NEXTAUTH_SECRET=""
# Activar solo si un proxy propio elimina/reemplaza X-Forwarded-For del cliente.
# Sin ese proxy, los límites de red se comparten entre conexiones a esta instancia.
TRUST_PROXY_HEADERS="false"
# Experimento visual sin aprobación de realismo. Mantener false para el cliente.
# Solo activar en una vista local para retomar el trabajo del GLB conservado.
JIRAH_AUTH_3D_PROTOTYPE="false"
# Inicialización: crea únicamente el primer administrador; no carga datos ficticios.
# No cambia cuentas existentes. Complete la identidad del administrador antes de entregar.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_CEDULA=""
SEED_ADMIN_PASSWORD=""
# Recuperación de contraseña: configurar un servidor SMTP real antes de publicar.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Solo para Mailpit local con npm run dev. Debe permanecer false en producción.
SMTP_LOCAL_TEST="false"
