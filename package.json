    "lucide-react": "^1.20.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.14",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "smtp-mailer": "npm:nodemailer@^10.0.16",
    "three": "^0.186.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
